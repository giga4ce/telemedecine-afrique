# Variables d'environnement du socle Compose POC (SPEC-02).
# Copier en `poc/.env` et adapter localement. Ne JAMAIS committer `poc/.env`.
# Valeurs d'exemple non sensibles — usage strictement local / démonstration.

# --- PostgreSQL (accès interne au réseau Docker uniquement, pas de port hôte) ---
POSTGRES_DB=telemed_poc
POSTGRES_USER=telemed
POSTGRES_PASSWORD=change_me_local_only

# --- Orthanc ---
ORTHANC_NAME=POC-Teleradiologie

# --- Ports hôte (adaptables selon l'environnement local / OVH) ---
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
BACKEND_PORT=8000
OHIF_PORT=3000
# 3001 : 3000 est déjà pris par OHIF, 8080/8081 occupés sur la machine.
FRONTEND_PORT=3001
